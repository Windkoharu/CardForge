# 构建产物（tools/build_exe.py 生成，可随时重建）
dist/
.packaging/

# 用户配置（LLM 接入含 API 密钥，绝不提交）
workspace/config/llm.json
workspace/cardforge.json

# 运行期产物
workspace/out/
workspace/pics/
workspace/logs/
workspace/.cache/
workspace/.history/
__pycache__/
*.pyc

# 对决引擎（ocgcore.dll 195MB，超 GitHub 单文件 100MB 硬上限）。
# 它本来就是可选层：装 EDOPro 自带，或按 README 自行放入 vendor/engine/。
vendor/engine/

# 验收截图与比对产物（_probe 里的脚本、报告、文本证据保留提交）
_probe/**/*.png
_probe/**/*.jpg
_probe/**/*.ypk
_probe/**/*.pdf
_probe/**/*.dll
_probe/**/*.so

# 浏览器自动化临时 profile（tools/teach_video.py 跑无头 Edge 时生成，含缓存与登录态）
_probe/edgeprofile/

# 内部调研草稿与会话工作台
_research/
.workbuddy/

# 酒馆：另一个独立项目，只是放在本目录里，不属于 CardForge
酒馆/
